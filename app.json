{
  "expo": {
    "name": "EluSEEdate",
    "slug": "eluseedate",
    "owner": "eluseedate-thesis",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thesis.eluseedate",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to predict turn directions.",
        "NSMicrophoneUsageDescription": "Allow EluSEEdate to access your microphone for voice commands."
      }
    },
    "android": {
      "package": "com.thesis.eluseedate",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EluSEEdate to access your camera for turn prediction."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EluSEEdate to use your location for wayfinding."
        }
      ],
      "react-native-fast-tflite",
      [
        "react-native-vosk",
        {
          "models": ["assets/model-en-us"],
          "iOSMicrophonePermission": "Allow EluSEEdate to access your microphone for voice commands."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow EluSEEdate to access your microphone for voice commands.",
          "speechRecognitionPermission": "Allow EluSEEdate to use speech recognition.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "96f2420f-d15c-476e-9d4b-a4322ed7aa29"
      }
    }
  }
}
